    "control_aggregation": {
      "version": 1,
      "evaluation_point": "end_of_turn",
      "game_rule_relationship": "A Secured Supply Point is Controlled by its owner.",
      "analysis_policy": "Separate reversible unsecured Control from permanent Secured state, while also retaining their combined ownership/control measure.",
      "is_unsecured_controlled": "state_at_turn_end equals player",
      "is_secured": "state_at_turn_end equals player plus 2",
      "is_controlled_or_secured": "is_unsecured_controlled or is_secured",
      "required_identity": "controlled_or_secured_turns = unsecured_controlled_turns + secured_turns",
      "share_denominator": "all 24 game turns for lifecycle/site summaries and all 8 phase turns for phase summaries"
    },
    "neutral_and_contest": {
      "is_neutral": "state_at_turn_end equals 0, including an empty point",
      "is_contested": "both players have at least one Piece at turn end, regardless of which player Controls the unresolved point"
    },
    "objective_coverage": {
      "definition": "distinct adjacent Objectives actually supplied divided by the Supply Point's number of adjacent Objectives",
      "normalization": "site_adjacency_degree"
    },
    "securable_opportunity": {
      "repeated_unit": "player_supply_point_own_turn",
      "ever_securable_unit": "game_player_supply_point",
      "same_turn_take_rate": "securing events divided by repeated legal opportunities",
      "eventual_conversion_rate": "ever-securable player-sites eventually Secured divided by ever-securable player-sites"
    }
  },
