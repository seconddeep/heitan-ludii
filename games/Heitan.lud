(game "Heitan"
    (players 2)
    (equipment {
        (board (square 4))
        (piece "Disc" Each)
    })
    (rules
        (play
            (move Add
                (to (sites Empty))
                (then
                    (if (< (count MovesThisTurn) 2)
                        (moveAgain)
                    )
                )
            )
        )
        (end (if (is Full) (result Mover Draw)))
    )
)
