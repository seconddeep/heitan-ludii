//------------------------------------------------------------------------------
// Board-specific configuration

(option "Board" <Board> args:{
    <graph>
    <supplyPoints>
    <objectives>
    <namedPointRegions>
    <supplyGridLines>
    <piecesPerPlayer>
    <totalPlacements>
    <advantageScoreWeight>
    <securedScoreWeight>
}
    {
    (item "4x4"
        <
        (graph
            vertices:{
                // Supply Points S00-S44 (indices 0-24, row-major).
                {0 8} {2 8} {4 8} {6 8} {8 8}
                {0 6} {2 6} {4 6} {6 6} {8 6}
                {0 4} {2 4} {4 4} {6 4} {8 4}
                {0 2} {2 2} {4 2} {6 2} {8 2}
                {0 0} {2 0} {4 0} {6 0} {8 0}

                // Objectives O00-O33 (indices 25-40, row-major).
                {1 7} {3 7} {5 7} {7 7}
                {1 5} {3 5} {5 5} {7 5}
                {1 3} {3 3} {5 3} {7 3}
                {1 1} {3 1} {5 1} {7 1}
            }
            edges:{
                {25 0} {25 1} {25 5} {25 6}
                {26 1} {26 2} {26 6} {26 7}
                {27 2} {27 3} {27 7} {27 8}
                {28 3} {28 4} {28 8} {28 9}
