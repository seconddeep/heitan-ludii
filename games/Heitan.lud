                {40 18} {40 19} {40 23} {40 24}
            }
        )
        >
        <{0..24}>
        <{25..40}>
        <
        (regions "S00" {0}) (regions "S01" {1}) (regions "S02" {2})
        (regions "S03" {3}) (regions "S04" {4}) (regions "S10" {5})
        (regions "S11" {6}) (regions "S12" {7}) (regions "S13" {8})
