//------------------------------------------------------------------------------
// Shared Heitan mechanics

(define "PiecesPerPlayer" <Board:piecesPerPlayer>)
(define "TotalPlacements" <Board:totalPlacements>)
(define "AdvantageScoreWeight" <Board:advantageScoreWeight>)
(define "SecuredScoreWeight" <Board:securedScoreWeight>)

(define "PiecesAt"
    (count Stack Vertex at:#1
        if:(= #2 (who Vertex at:#1 level:(level)))
    )
)

(define "PointState"
    (if (is Empty #1)
        0
        (state Vertex at:#1 level:(topLevel Vertex at:#1))
    )
)

(define "PointStateAfterTurn"
    // 0 = Neutral, 1/2 = Controlled or Advantage for P1/P2,
    // 3/4 = Secured by P1/P2.
    (if (= 3 ("PiecesAt" #1 1))
        3
        (if (= 3 ("PiecesAt" #1 2))
            4
            (if (> ("PiecesAt" #1 1) ("PiecesAt" #1 2))
                1
                (if (> ("PiecesAt" #1 2) ("PiecesAt" #1 1))
                    2
                    0
                )
            )
        )
    )
)

(define "ObjectivesInState"
    (count Sites in:(forEach
        (sites "Objectives")
        if:(= ("PointState" (site)) #1)
    ))
)

(define "PiecesOnObjectives"
    (count Stack Vertex to:(sites "Objectives")
        if:(= #1 (who Vertex at:(to) level:(level)))
    )
)

(define "ObjectiveScore"
    // The board configuration supplies weights that encode the tiebreak order
    // lexicographically for its Piece and Objective limits.
    (+ {
        (* ("SecuredScoreWeight") ("ObjectivesInState" (+ #1 2)))
        (* ("AdvantageScoreWeight") ("ObjectivesInState" #1))
        ("PiecesOnObjectives" #1)
    })
)

(define "AllPiecesPlaced"
    (= ("TotalPlacements") (count Stack Vertex to:(sites Board)))
)

(define "PlacementSite"
    (arrayValue
        (values Remembered "PlacementsThisTurn")
        index:#1
    )
)

(define "UpdatePlacedPoint"
    (set State Vertex at:#1
        ("PointStateAfterTurn" #1)
    )
)

(define "UpdatePointStates"
    (and {
        // Update all three placed points after the completed turn.
        ("UpdatePlacedPoint" ("PlacementSite" 0))
        ("UpdatePlacedPoint" ("PlacementSite" 1))
        ("UpdatePlacedPoint" ("PlacementSite" 2))
        (forget Value "PlacementsThisTurn" All)
        (forget Value "UsedSupplyPoints" All)
    })
)

(define "WithinPointLimit"
    (<
        (count Stack Vertex at:#1
            if:(= (mover) (who Vertex at:#1 level:(level)))
        )
        3
    )
)

(define "AvailableControlledSupplyPoint"
    (and
        (or
            (= ("PointState" #1) (mover))
            (= ("PointState" #1) (+ (mover) 2))
        )
        (=
            0
            (count Value #1
                in:(values Remembered "UsedSupplyPoints")
            )
        )
    )
)

(define "SupplyPointPlacementAllowed"
    (and {
        (is In (to) (sites "SupplyPoints"))
        ("WithinPointLimit" (to))
        // Secured Supply Points (states 3 and 4) are closed permanently.
        (< ("PointState" (to)) 3)
        (<
            (count Value (to)
                in:(values Remembered "PlacementsThisTurn")
            )
            2
        )
    })
)

(define "RecordPlacement"
    (remember Value "PlacementsThisTurn" #1
        (then
            (if (< (count MovesThisTurn) 2)
                (moveAgain)
                ("UpdatePointStates")
            )
        )
    )
)

(define "SupplyPointPlacement"
    (move Add
        (piece (id "Disc" Mover) state:("PointState" (to)))
        (to
            (sites Board)
            if:("SupplyPointPlacementAllowed")
        )
        stack:True
        (then
            ("RecordPlacement" (last To))
        )
    )
)

(define "ObjectivePlacement"
    // Select the Objective first, then the Supply Point used for this placement.
    (move Select
        (from
            (sites "Objectives")
            if:(and
                ("WithinPointLimit" (from))
                // Secured Objectives (states 3 and 4) are closed permanently.
                (< ("PointState" (from)) 3)
            )
        )
        (to
            (intersection
                (sites Around (from))
                (sites "SupplyPoints")
            )
            if:("AvailableControlledSupplyPoint" (to))
        )
        (then
            (and {
                (add
                    (piece (id "Disc" Mover) state:("PointState" (last From)))
                    (to (last From))
                    stack:True
                )
                (remember Value "UsedSupplyPoints" (last To))
                ("RecordPlacement" (last From))
            })
        )
    )
)

(game "Heitan"
    (players 2)
    (equipment {
        (board
            <Board:graph>
            use:Vertex
        )
        (piece "Disc" Each maxState:4)
        (regions "SupplyPoints" <Board:supplyPoints>)
        (regions "Objectives" <Board:objectives>)
        <Board:namedPointRegions>
    })
    (rules
        (play
            (or
                ("SupplyPointPlacement")
                ("ObjectivePlacement")
            )
        )
        (end
            (if ("AllPiecesPlaced")
                (byScore {
                    (score P1 ("ObjectiveScore" 1))
                    (score P2 ("ObjectiveScore" 2))
                })
            )
        )
    )
)

(metadata
    (graphics {
        (player Colour P1 (colour Black))
        (player Colour P2 (colour White))
        (board Style PenAndPaper)
        (board Colour InnerVertices (colour Hidden))
        (board Colour OuterVertices (colour Hidden))
        (show Line
            <Board:supplyGridLines>
            (colour 128 128 128)
        )
    })
)
